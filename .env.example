# --- ESPN (checked first — see src/lib/espn/adapter.ts) ---
# Find ESPN_LEAGUE_ID in your league's URL:
# fantasy.espn.com/football/team?leagueId=XXXXXXX&teamId=1&seasonId=2025
ESPN_LEAGUE_ID=
ESPN_SEASON=2025
# Only needed for a PRIVATE league (public leagues: leave both blank).
# Get these from a browser logged into fantasy.espn.com: DevTools ->
# Application -> Cookies -> fantasy.espn.com -> copy `espn_s2` and `SWID`
# (SWID includes the surrounding curly braces). Treat these as a password —
# put them here in .env.local (gitignored), never commit or share them.
ESPN_S2=
ESPN_SWID=
# How many top seeds get a first-round bye (ESPN doesn't expose this directly).
ESPN_FIRST_ROUND_BYES=2

# --- Sleeper (used only if ESPN_LEAGUE_ID is unset) ---
# Sleeper's read API is public/keyless — find your league_id in the Sleeper
# app URL (League -> Settings) or via
# https://api.sleeper.app/v1/user/<username>/leagues/nfl/<season>
SLEEPER_LEAGUE_ID=
SLEEPER_SEASON=2025

# How many trials the Monte Carlo playoff simulator runs per request.
SIMULATION_TRIALS=10000

# Live scoreboard poll interval (ms) used by the client-side polling hook.
NEXT_PUBLIC_LIVE_POLL_INTERVAL_MS=15000
